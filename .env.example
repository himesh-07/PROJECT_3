# ──────────────────────────────────────────────
#  ChefMind AI — Configuration
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── MODE SWITCH ────────────────────────────────
# Set to true  → run fully FREE & LOCAL (Ollama + HuggingFace, no IBM account needed)
# Set to false → run with IBM watsonx Granite + IBM slate embeddings
USE_LOCAL=true

# ── BACKEND SELECTOR ───────────────────────────
# Options: gemini | ollama | watsonx
# This overrides USE_LOCAL when set explicitly
LLM_BACKEND=gemini

# ── GEMINI MODE (LLM_BACKEND=gemini) ───────────
# Free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model (gemini-1.5-flash = free tier, gemini-1.5-pro = paid)
GEMINI_MODEL=gemini-1.5-flash

# ── LOCAL MODE (LLM_BACKEND=ollama) ────────────
# Ollama model — pull first: ollama pull llama3
OLLAMA_MODEL=llama3

# ── IBM WATSONX MODE (LLM_BACKEND=watsonx) ─────
# IBM Cloud API key
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# watsonx.ai service URL
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# watsonx.ai project ID
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# Foundation model (optional override)
# WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
